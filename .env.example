# Server Configuration
PORT=5000

# Google Gemini AI API Key (Optional - website includes romantic fallbacks if not provided)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# MongoDB Connection String (Optional - website works 100% smoothly without MongoDB)
# Example: mongodb+srv://<user>:<password>@cluster.mongodb.net/birthday_db
MONGODB_URI=
